{% liquid
  assign latest_products_limit = section.settings.products_limit | default: 10
  assign new_arrivals_collection = section.settings.new_arrivals_collection
  assign hot_items_collection = section.settings.hot_items_collection
  assign bestsellers_collection = section.settings.bestsellers_collection
  if new_arrivals_collection == blank
    assign new_arrivals_collection = collections['all']
  endif
  if hot_items_collection == blank
    assign hot_items_collection = collections['all']
  endif
  if bestsellers_collection == blank
    assign bestsellers_collection = collections['all']
  endif
%}
<section class="na-home-section na-home-products">
  <div class="na-home-wrap">
    <div class="na-home-products-head">
      <h2 class="na-home-products-title">{{ section.settings.heading }}</h2>
      <div class="na-home-tabs" role="tablist">
        <button type="button" class="na-home-tab is-active" data-na-home-tab="new">{{ section.settings.tab_label_new }}</button>
        <button type="button" class="na-home-tab" data-na-home-tab="hot">{{ section.settings.tab_label_hot }}</button>
        <button type="button" class="na-home-tab" data-na-home-tab="best">{{ section.settings.tab_label_best }}</button>
      </div>
    </div>

    <div class="na-home-product-grid na-home-tab-panel is-active" data-na-home-tab-panel="new">
      {% for product in new_arrivals_collection.products limit: latest_products_limit %}
        <div class="na-home-product-item">
          {% render 'card-product', product: product, image_ratio: settings.pcard_image_ratio, section_index: section.index, index: forloop.index, quick_view_suffix: '-home-new', enable_quick_add: true, show_vendor: false %}
        </div>
      {% else %}
        <p class="na-home-empty-note">No products in selected collection.</p>
      {% endfor %}
    </div>

    <div class="na-home-product-grid na-home-tab-panel" data-na-home-tab-panel="hot">
      {% for product in hot_items_collection.products limit: latest_products_limit %}
        <div class="na-home-product-item">
          {% render 'card-product', product: product, image_ratio: settings.pcard_image_ratio, section_index: section.index, index: forloop.index, quick_view_suffix: '-home-hot', enable_quick_add: true, show_vendor: false %}
        </div>
      {% else %}
        <p class="na-home-empty-note">No products in selected collection.</p>
      {% endfor %}
    </div>

    <div class="na-home-product-grid na-home-tab-panel" data-na-home-tab-panel="best">
      {% for product in bestsellers_collection.products limit: latest_products_limit %}
        <div class="na-home-product-item">
          {% render 'card-product', product: product, image_ratio: settings.pcard_image_ratio, section_index: section.index, index: forloop.index, quick_view_suffix: '-home-best', enable_quick_add: true, show_vendor: false %}
        </div>
      {% else %}
        <p class="na-home-empty-note">No products in selected collection.</p>
      {% endfor %}
    </div>
  </div>

  <script>
    (function () {
      var section = document.currentScript && document.currentScript.closest('.na-home-section');
      if (!section || section.dataset.naHomeTabsInit === 'true') return;
      section.dataset.naHomeTabsInit = 'true';
      var buttons = section.querySelectorAll('[data-na-home-tab]');
      var panels = section.querySelectorAll('[data-na-home-tab-panel]');
      buttons.forEach(function (button) {
        button.addEventListener('click', function () {
          var tab = button.getAttribute('data-na-home-tab');
          buttons.forEach(function (item) { item.classList.toggle('is-active', item === button); });
          panels.forEach(function (panel) { panel.classList.toggle('is-active', panel.getAttribute('data-na-home-tab-panel') === tab); });
        });
      });
    })();
  </script>
</section>
{% schema %}
{
  "name": "NA Latest Products",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Latest Products" },
    { "type": "collection", "id": "new_arrivals_collection", "label": "New Arrivals collection" },
    { "type": "collection", "id": "hot_items_collection", "label": "Hot Items collection" },
    { "type": "collection", "id": "bestsellers_collection", "label": "Bestsellers collection" },
    { "type": "range", "id": "products_limit", "label": "Products per tab", "min": 4, "max": 20, "step": 1, "default": 10 },
    { "type": "text", "id": "tab_label_new", "label": "New tab label", "default": "New Arrivals" },
    { "type": "text", "id": "tab_label_hot", "label": "Hot tab label", "default": "Hot Items" },
    { "type": "text", "id": "tab_label_best", "label": "Best tab label", "default": "Bestsellers" }
  ],
  "presets": [
    { "name": "NA Latest Products" }
  ]
}
{% endschema %}
