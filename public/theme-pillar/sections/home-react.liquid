{% liquid
  assign categories = 'Gel Polish|Nail Tools|UV/LED Lamps|Nail Care|Decorations|Extensions|Kits' | split: '|'
  assign collection_tiles = 'Gel Base:#2C2926|Salon Equipment:#3B3530|Acryl & Extensions:#4A423B|Nail Art Supplies:#584F47|Body Care:#665C53|Accessories:#5C4A3E' | split: '|'
  assign popular_searches = 'Gel Polish Sets|Builder Gel|Nail Lamp|French Tips|Nail Art Brushes|Base Coat|Top Coat|Cuticle Oil|Nail Stickers|Polygel Kit|Rubber Base|Chrome Powder' | split: '|'
  assign feature_tags = 'EU Certified|TPO-Free Gels|Salon Tested|Cruelty-Free' | split: '|'
  assign all_products_url = routes.all_products_collection_url
  assign account_register_url = routes.account_register_url
  assign search_url = routes.search_url
  assign blog_base_url = routes.root_url | append: 'blogs/news'
%}

<section id="na-home-{{ section.id }}" class="na-home">
  <style>
    #na-home-{{ section.id }} {
      --na-color-60: #ffffff;
      --na-color-30: #1a1a1a;
      --na-color-10: #c8a08c;
      --na-muted: #6b6b6b;
      --na-border: #e8e5e3;
      --na-bg-soft: #f5f3f1;
      color: var(--na-color-30);
      font-family: Inter, "Helvetica Neue", Arial, sans-serif;
      background: var(--na-color-60);
    }

    #na-home-{{ section.id }} *,
    #na-home-{{ section.id }} *::before,
    #na-home-{{ section.id }} *::after {
      box-sizing: border-box;
    }

    #na-home-{{ section.id }} a,
    #na-home-{{ section.id }} button,
    #na-home-{{ section.id }} input {
      font: inherit;
    }

    #na-home-{{ section.id }} button {
      border: 0;
      cursor: pointer;
    }

    #na-home-{{ section.id }} .na-container {
      width: min(100%, 1415px);
      margin: 0 auto;
      padding-left: 16px;
      padding-right: 16px;
    }

    #na-home-{{ section.id }} .na-pill-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      border-radius: 999px;
      transition: all 0.25s ease;
      text-decoration: none;
      font-weight: 600;
      letter-spacing: 0.02em;
    }

    #na-home-{{ section.id }} .na-section-title {
      margin: 0;
      color: var(--na-color-30);
      letter-spacing: -0.02em;
    }

    #na-home-{{ section.id }} .na-hero {
      padding-top: 16px;
      padding-bottom: 0;
    }

    #na-home-{{ section.id }} .na-hero-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 12px;
    }

    #na-home-{{ section.id }} .na-hero-card {
      position: relative;
      border-radius: 12px;
      overflow: hidden;
      min-height: 280px;
    }

    #na-home-{{ section.id }} .na-hero-card--large {
      background: #f5f3f1;
    }

    #na-home-{{ section.id }} .na-hero-card--tall {
      background: #ede8e3;
      min-height: 240px;
    }

    #na-home-{{ section.id }} .na-hero-card--small-a {
      min-height: 140px;
      background: #e8e3de;
    }

    #na-home-{{ section.id }} .na-hero-card--small-b {
      min-height: 140px;
      background: #e3ddd7;
    }

    #na-home-{{ section.id }} .na-hero-large-content {
      position: absolute;
      left: 0;
      bottom: 0;
      padding: 20px;
      display: flex;
      flex-direction: column;
      gap: 14px;
    }

    #na-home-{{ section.id }} .na-hero-small-content {
      position: absolute;
      inset: 0;
      padding: 20px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
    }

    #na-home-{{ section.id }} .na-caption {
      text-transform: uppercase;
      letter-spacing: 0.15em;
      margin: 0;
      font-size: 12px;
      font-weight: 600;
    }

    #na-home-{{ section.id }} .na-caption-muted {
      color: #999;
      font-weight: 500;
    }

    #na-home-{{ section.id }} .na-hero-title {
      margin: 0;
      line-height: 1.1;
      letter-spacing: -0.02em;
      font-size: 28px;
      font-weight: 700;
    }

    #na-home-{{ section.id }} .na-hero-tall-inner {
      position: absolute;
      inset: 0;
      padding: 24px;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      text-align: center;
    }

    #na-home-{{ section.id }} .na-hero-discount {
      color: var(--na-color-30);
      font-size: 44px;
      line-height: 1;
      letter-spacing: -0.03em;
      font-weight: 800;
      margin: 0 0 4px;
    }

    #na-home-{{ section.id }} .na-hero-subtitle {
      margin: 0 0 12px;
      font-size: 16px;
      font-weight: 600;
      color: var(--na-color-30);
      letter-spacing: -0.01em;
    }

    #na-home-{{ section.id }} .na-hero-note {
      margin: 0 0 16px;
      color: var(--na-muted);
      font-size: 12px;
      line-height: 1.6;
      max-width: 220px;
    }

    #na-home-{{ section.id }} .na-btn-dark {
      background: var(--na-color-30);
      color: #fff;
      padding: 12px 24px;
      font-size: 13px;
    }

    #na-home-{{ section.id }} .na-btn-dark:hover {
      background: #333;
    }

    #na-home-{{ section.id }} .na-btn-light {
      background: #fff;
      color: #2e4a3e;
      padding: 12px 24px;
      font-size: 13px;
    }

    #na-home-{{ section.id }} .na-btn-light:hover {
      background: var(--na-color-10);
      color: #fff;
    }

    #na-home-{{ section.id }} .na-btn-accent {
      background: var(--na-color-10);
      color: #fff;
      padding: 12px 24px;
      font-size: 13px;
    }

    #na-home-{{ section.id }} .na-btn-accent:hover {
      background: #b8907a;
    }

    #na-home-{{ section.id }} .na-btn-soft {
      background: rgba(255, 255, 255, 0.5);
      color: var(--na-color-30);
      padding: 10px 20px;
      font-size: 12px;
    }

    #na-home-{{ section.id }} .na-btn-soft:hover {
      background: #fff;
    }

    #na-home-{{ section.id }} .na-promo {
      margin-top: 16px;
    }

    #na-home-{{ section.id }} .na-promo-inner {
      background: #f5ede6;
      border-radius: 12px;
      padding: 24px 20px;
      display: flex;
      flex-direction: column;
      gap: 20px;
      align-items: center;
      justify-content: space-between;
      text-align: center;
    }

    #na-home-{{ section.id }} .na-promo-label {
      margin: 0;
      color: var(--na-color-30);
      font-size: 13px;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      font-weight: 700;
    }

    #na-home-{{ section.id }} .na-countdown {
      display: flex;
      align-items: center;
      gap: 8px;
    }

    #na-home-{{ section.id }} .na-countdown-value {
      min-width: 36px;
      font-size: 26px;
      line-height: 1;
      font-weight: 700;
      color: var(--na-color-30);
      font-variant-numeric: tabular-nums;
      text-align: center;
    }

    #na-home-{{ section.id }} .na-countdown-sep {
      color: rgba(26, 26, 26, 0.4);
      font-size: 16px;
      font-weight: 700;
      line-height: 1;
    }

    #na-home-{{ section.id }} .na-promo-desc {
      display: none;
      max-width: 220px;
      color: #3a3a3a;
      font-size: 14px;
      line-height: 1.6;
      margin: 0;
    }

    #na-home-{{ section.id }} .na-copy-btn {
      background: var(--na-color-30);
      color: #fff;
      padding: 12px 20px;
      font-size: 13px;
    }

    #na-home-{{ section.id }} .na-copy-btn:hover {
      background: #333;
    }

    #na-home-{{ section.id }} .na-copy-icon {
      width: 16px;
      height: 16px;
      fill: none;
      stroke: currentColor;
      stroke-width: 1.8;
      stroke-linecap: round;
      stroke-linejoin: round;
      flex-shrink: 0;
    }

    #na-home-{{ section.id }} .na-categories {
      margin-top: 8px;
    }

    #na-home-{{ section.id }} .na-categories-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 8px;
    }

    #na-home-{{ section.id }} .na-category-card {
      border: 1px solid var(--na-border);
      border-radius: 12px;
      background: #fff;
      padding: 12px;
      transition: border-color 0.2s ease, box-shadow 0.2s ease;
    }

    #na-home-{{ section.id }} .na-category-card:hover {
      border-color: var(--na-color-10);
      box-shadow: 0 6px 16px rgba(17, 17, 17, 0.06);
    }

    #na-home-{{ section.id }} .na-category-image {
      aspect-ratio: 1 / 1;
      background: var(--na-bg-soft);
      border-radius: 10px;
      margin-bottom: 10px;
    }

    #na-home-{{ section.id }} .na-category-meta {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 8px;
    }

    #na-home-{{ section.id }} .na-category-name {
      margin: 0;
      font-size: 11px;
      font-weight: 600;
      color: var(--na-color-30);
      line-height: 1.35;
    }

    #na-home-{{ section.id }} .na-category-arrow {
      width: 28px;
      height: 28px;
      border-radius: 999px;
      border: 1px solid var(--na-border);
      display: none;
      align-items: center;
      justify-content: center;
      color: #999;
      transition: all 0.2s ease;
      flex-shrink: 0;
    }

    #na-home-{{ section.id }} .na-category-arrow svg {
      width: 14px;
      height: 14px;
      fill: none;
      stroke: currentColor;
      stroke-width: 2;
      stroke-linecap: round;
      stroke-linejoin: round;
    }

    #na-home-{{ section.id }} .na-category-card:hover .na-category-arrow {
      color: var(--na-color-10);
      border-color: var(--na-color-10);
    }

    #na-home-{{ section.id }} .na-brands {
      padding: 32px 0 40px;
    }

    #na-home-{{ section.id }} .na-brands-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      margin-bottom: 20px;
    }

    #na-home-{{ section.id }} .na-brands-title {
      margin: 0;
      font-size: 18px;
      font-weight: 600;
      letter-spacing: -0.01em;
    }

    #na-home-{{ section.id }} .na-view-all {
      color: var(--na-color-10);
      text-transform: uppercase;
      letter-spacing: 0.1em;
      font-size: 12px;
      font-weight: 600;
      text-decoration: none;
    }

    #na-home-{{ section.id }} .na-view-all:hover {
      color: #b08a74;
    }

    #na-home-{{ section.id }} .na-brands-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 8px;
    }

    #na-home-{{ section.id }} .na-brand-item {
      height: 56px;
      border-radius: 10px;
      border: 1px solid #e5e5e5;
      background: #fafaf9;
      display: flex;
      align-items: center;
      justify-content: center;
      text-decoration: none;
      color: #6b6b6b;
      font-size: 12px;
      letter-spacing: 0.03em;
      font-weight: 500;
      white-space: nowrap;
      transition: all 0.2s ease;
      padding: 0 10px;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    #na-home-{{ section.id }} .na-brand-item:hover {
      color: var(--na-color-30);
      border-color: var(--na-color-10);
      background: #fff;
    }

    #na-home-{{ section.id }} .na-brands-toggle-wrap {
      display: flex;
      justify-content: center;
      margin-top: 20px;
    }

    #na-home-{{ section.id }} .na-brands-toggle {
      border-radius: 999px;
      border: 1px solid #e5e5e5;
      background: transparent;
      color: var(--na-color-30);
      text-transform: uppercase;
      letter-spacing: 0.1em;
      font-size: 12px;
      font-weight: 600;
      padding: 10px 20px;
      transition: all 0.2s ease;
    }

    #na-home-{{ section.id }} .na-brands-toggle:hover {
      color: var(--na-color-10);
      border-color: var(--na-color-10);
    }

    #na-home-{{ section.id }} .na-products {
      padding: 40px 0 20px;
    }

    #na-home-{{ section.id }} .na-products-head {
      display: flex;
      flex-direction: column;
      gap: 16px;
      margin-bottom: 24px;
    }

    #na-home-{{ section.id }} .na-products-title {
      margin: 0;
      font-size: 24px;
      font-weight: 700;
      letter-spacing: -0.02em;
      color: var(--na-color-30);
    }

    #na-home-{{ section.id }} .na-tabs {
      display: flex;
      gap: 16px;
      overflow-x: auto;
      padding-bottom: 4px;
      scrollbar-width: none;
    }

    #na-home-{{ section.id }} .na-tabs::-webkit-scrollbar {
      display: none;
    }

    #na-home-{{ section.id }} .na-tab {
      background: transparent;
      color: #999;
      border-bottom: 2px solid transparent;
      font-size: 13px;
      padding: 0 0 6px;
      white-space: nowrap;
      font-weight: 500;
      transition: color 0.2s ease, border-color 0.2s ease;
    }

    #na-home-{{ section.id }} .na-tab.is-active {
      color: var(--na-color-30);
      border-color: var(--na-color-30);
      font-weight: 600;
    }

    #na-home-{{ section.id }} .na-tab:hover {
      color: #3a3a3a;
    }

    #na-home-{{ section.id }} .na-product-grid,
    #na-home-{{ section.id }} .na-tools-grid,
    #na-home-{{ section.id }} .na-favorites-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 12px;
    }

    #na-home-{{ section.id }} .na-card {
      cursor: pointer;
    }

    #na-home-{{ section.id }} .na-card-media {
      position: relative;
      aspect-ratio: 1 / 1;
      border-radius: 12px;
      overflow: hidden;
      background: var(--na-bg-soft);
      margin-bottom: 14px;
    }

    #na-home-{{ section.id }} .na-card-badge {
      position: absolute;
      top: 12px;
      left: 12px;
      border-radius: 999px;
      font-size: 11px;
      font-weight: 600;
      letter-spacing: 0.04em;
      padding: 4px 10px;
    }

    #na-home-{{ section.id }} .na-badge-sale {
      background: var(--na-color-10);
      color: #fff;
    }

    #na-home-{{ section.id }} .na-badge-bestseller {
      background: var(--na-color-30);
      color: #fff;
    }

    #na-home-{{ section.id }} .na-badge-new {
      background: #fff;
      color: var(--na-color-30);
      border: 1px solid var(--na-border);
    }

    #na-home-{{ section.id }} .na-card-heart {
      position: absolute;
      top: 12px;
      right: 12px;
      width: 32px;
      height: 32px;
      border-radius: 999px;
      border: 0;
      background: rgba(255, 255, 255, 0.8);
      backdrop-filter: blur(4px);
      display: none;
      align-items: center;
      justify-content: center;
      color: #3a3a3a;
      transition: background-color 0.2s ease;
    }

    #na-home-{{ section.id }} .na-card-heart svg,
    #na-home-{{ section.id }} .na-card-cart svg {
      width: 15px;
      height: 15px;
      fill: none;
      stroke: currentColor;
      stroke-width: 1.8;
      stroke-linecap: round;
      stroke-linejoin: round;
    }

    #na-home-{{ section.id }} .na-card-heart:hover {
      background: #fff;
    }

    #na-home-{{ section.id }} .na-card-quick {
      position: absolute;
      left: 12px;
      right: 12px;
      bottom: 12px;
      opacity: 0;
      transform: translateY(8px);
      transition: opacity 0.25s ease, transform 0.25s ease;
    }

    #na-home-{{ section.id }} .na-card-cart {
      width: 100%;
      border-radius: 10px;
      border: 0;
      background: var(--na-color-30);
      color: #fff;
      font-size: 13px;
      font-weight: 500;
      padding: 10px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      transition: background-color 0.2s ease;
    }

    #na-home-{{ section.id }} .na-card-cart:hover {
      background: #333;
    }

    #na-home-{{ section.id }} .na-card:hover .na-card-heart {
      display: inline-flex;
    }

    #na-home-{{ section.id }} .na-card:hover .na-card-quick {
      opacity: 1;
      transform: translateY(0);
    }

    #na-home-{{ section.id }} .na-card-name {
      margin: 0;
      font-size: 14px;
      font-weight: 500;
      color: var(--na-color-30);
      line-height: 1.4;
      transition: color 0.2s ease;
      display: -webkit-box;
      -webkit-line-clamp: 1;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }

    #na-home-{{ section.id }} .na-card:hover .na-card-name {
      color: var(--na-color-10);
    }

    #na-home-{{ section.id }} .na-card-prices {
      display: flex;
      align-items: center;
      gap: 8px;
      margin-top: 4px;
    }

    #na-home-{{ section.id }} .na-card-price {
      font-size: 15px;
      font-weight: 600;
      color: var(--na-color-30);
    }

    #na-home-{{ section.id }} .na-card-price-old {
      font-size: 13px;
      color: #999;
      text-decoration: line-through;
    }

    #na-home-{{ section.id }} .na-collection-banner {
      padding: 16px 0;
    }

    #na-home-{{ section.id }} .na-collection-title {
      margin: 0 auto 24px;
      text-align: center;
      max-width: 760px;
      font-size: 20px;
      font-weight: 600;
      letter-spacing: -0.01em;
      line-height: 1.35;
      color: var(--na-color-30);
    }

    #na-home-{{ section.id }} .na-collection-title .na-accent {
      color: var(--na-color-10);
    }

    #na-home-{{ section.id }} .na-tools-tiles {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 12px;
    }

    #na-home-{{ section.id }} .na-tool-tile {
      min-height: 80px;
      border-radius: 12px;
      overflow: hidden;
      display: flex;
      align-items: center;
      justify-content: center;
      text-align: center;
      color: #fff;
      font-size: 12px;
      font-weight: 600;
      letter-spacing: 0.02em;
      text-decoration: none;
      padding: 10px;
      transition: filter 0.2s ease;
    }

    #na-home-{{ section.id }} .na-tool-tile:hover {
      filter: brightness(1.05);
    }

    #na-home-{{ section.id }} .na-featured {
      padding: 32px 0 40px;
    }

    #na-home-{{ section.id }} .na-featured-box {
      background: #2e4a3e;
      border-radius: 16px;
      overflow: hidden;
      min-height: 320px;
      display: flex;
      flex-direction: column;
    }

    #na-home-{{ section.id }} .na-featured-left {
      flex: 1;
      padding: 24px;
      display: flex;
      flex-direction: column;
      justify-content: center;
    }

    #na-home-{{ section.id }} .na-featured-kicker {
      margin: 0 0 10px;
      text-transform: uppercase;
      letter-spacing: 0.15em;
      color: rgba(255, 255, 255, 0.6);
      font-size: 11px;
      font-weight: 500;
    }

    #na-home-{{ section.id }} .na-featured-title {
      margin: 0 0 16px;
      color: #fff;
      font-size: 24px;
      font-weight: 700;
      line-height: 1.2;
      letter-spacing: -0.02em;
    }

    #na-home-{{ section.id }} .na-featured-text {
      margin: 0 0 20px;
      color: rgba(255, 255, 255, 0.7);
      font-size: 13px;
      line-height: 1.6;
      max-width: 420px;
    }

    #na-home-{{ section.id }} .na-featured-tags {
      display: flex;
      flex-wrap: wrap;
      gap: 10px 20px;
      margin-bottom: 20px;
    }

    #na-home-{{ section.id }} .na-featured-tag {
      color: rgba(255, 255, 255, 0.8);
      font-size: 12px;
      font-weight: 500;
      display: inline-flex;
      align-items: center;
      gap: 8px;
    }

    #na-home-{{ section.id }} .na-featured-dot {
      width: 6px;
      height: 6px;
      border-radius: 999px;
      background: var(--na-color-10);
      flex-shrink: 0;
    }

    #na-home-{{ section.id }} .na-featured-right {
      display: none;
      flex: 1;
      position: relative;
    }

    #na-home-{{ section.id }} .na-featured-image {
      position: absolute;
      inset: 24px;
      border-radius: 16px;
      background: #d9cec5;
    }

    #na-home-{{ section.id }} .na-featured-note {
      position: absolute;
      right: 24px;
      bottom: 24px;
      background: rgba(255, 255, 255, 0.92);
      backdrop-filter: blur(5px);
      border-radius: 12px;
      padding: 16px;
      max-width: 260px;
    }

    #na-home-{{ section.id }} .na-featured-note p {
      margin: 0;
      color: #3a3a3a;
      font-size: 12px;
      line-height: 1.55;
    }

    #na-home-{{ section.id }} .na-featured-note a {
      display: inline-block;
      margin-top: 8px;
      color: var(--na-color-10);
      text-decoration: none;
      font-size: 12px;
      font-weight: 600;
    }

    #na-home-{{ section.id }} .na-tools,
    #na-home-{{ section.id }} .na-favorites,
    #na-home-{{ section.id }} .na-searches {
      padding: 32px 0 40px;
    }

    #na-home-{{ section.id }} .na-tools-title,
