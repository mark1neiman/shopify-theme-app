{% liquid
  assign shop_by_collection = section.settings.shop_by_collection
  assign shop_by_limit = section.settings.shop_by_limit | default: 5
  assign feature_tag_blocks = section.blocks | where: 'type', 'feature_tag'
  assign fallback_tags = 'EU Certified|TPO-Free Gels|Salon Tested|Cruelty-Free' | split: '|'
  if shop_by_collection == blank
    assign shop_by_collection = collections['all']
  endif
%}
<section class="na-home-section na-home-featured">
  <div class="na-home-wrap">
    <div class="na-home-featured-box">
      <div class="na-home-featured-left">
        <p class="na-home-featured-kicker">{{ section.settings.featured_kicker }}</p>
        <h2 class="na-home-featured-title">{{ section.settings.featured_title | escape | newline_to_br }}</h2>
        <p class="na-home-featured-text">{{ section.settings.featured_text }}</p>
        <div class="na-home-featured-tags">
          {% if feature_tag_blocks.size > 0 %}
            {% for block in feature_tag_blocks %}
              <span class="na-home-featured-tag" {{ block.shopify_attributes }}><span class="na-home-featured-dot"></span>{{ block.settings.label }}</span>
            {% endfor %}
          {% else %}
            {% for tag in fallback_tags %}
              <span class="na-home-featured-tag"><span class="na-home-featured-dot"></span>{{ tag }}</span>
            {% endfor %}
          {% endif %}
        </div>
        <a href="{{ section.settings.featured_button_link | default: routes.root_url }}" class="na-home-pill-btn na-home-btn-light">{{ section.settings.featured_button_label }}</a>
      </div>
      <div class="na-home-featured-right">
        <div class="na-home-featured-image">
          {% if section.settings.featured_image != blank %}
            {{ section.settings.featured_image | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '400,600,800,1000', alt: section.settings.featured_title }}
          {% endif %}
        </div>
        <div class="na-home-featured-note">
          <p>{{ section.settings.featured_note_text }}</p>
          <a href="{{ section.settings.featured_note_link | default: routes.root_url }}">{{ section.settings.featured_note_link_label }}</a>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="na-home-section na-home-shop-by">
  <div class="na-home-wrap">
    <h2 class="na-home-section-title">{{ section.settings.shop_by_heading }}</h2>
    <div class="na-home-shop-grid">
      {% for product in shop_by_collection.products limit: shop_by_limit %}
        <div class="na-home-product-item">
          {% render 'card-product', product: product, image_ratio: settings.pcard_image_ratio, section_index: section.index, index: forloop.index, quick_view_suffix: '-home-shop', enable_quick_add: true, show_vendor: false %}
        </div>
      {% else %}
        <p class="na-home-empty-note">No products in selected collection.</p>
      {% endfor %}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "NA Featured + Shop",
  "settings": [
    { "type": "text", "id": "featured_kicker", "label": "Featured kicker", "default": "Quality and Safety" },
    { "type": "textarea", "id": "featured_title", "label": "Featured title", "default": "Premium Certified\nProducts Only" },
    { "type": "textarea", "id": "featured_text", "label": "Featured text", "default": "Every product in our store meets the highest European safety standards. All gels are TPO-free and safe for both nail technicians and clients." },
    { "type": "image_picker", "id": "featured_image", "label": "Featured image" },
    { "type": "text", "id": "featured_button_label", "label": "Featured button label", "default": "View Certificates" },
    { "type": "url", "id": "featured_button_link", "label": "Featured button link" },
    { "type": "textarea", "id": "featured_note_text", "label": "Featured note text", "default": "All our gels are formulated without TPO photoinitiators. Safe for sensitive clients and professionals alike." },
    { "type": "text", "id": "featured_note_link_label", "label": "Featured note link label", "default": "Learn more ->" },
    { "type": "url", "id": "featured_note_link", "label": "Featured note link" },
    { "type": "text", "id": "shop_by_heading", "label": "Shop by heading", "default": "Shop By Gel Systems" },
    { "type": "collection", "id": "shop_by_collection", "label": "Shop by collection" },
    { "type": "range", "id": "shop_by_limit", "label": "Shop by product limit", "min": 3, "max": 20, "step": 1, "default": 5 }
  ],
  "blocks": [
    {
      "type": "feature_tag",
      "name": "Feature tag",
      "settings": [
        { "type": "text", "id": "label", "label": "Tag text", "default": "EU Certified" }
      ]
    }
  ],
  "presets": [
    { "name": "NA Featured + Shop" }
  ]
}
{% endschema %}
