  <script>
    (function () {
      var root = document.getElementById('na-home-{{ section.id }}');
      if (!root || root.dataset.naInit === 'true') return;
      root.dataset.naInit = 'true';
      var allProductsUrl = {{ all_products_url | json }};

      var brands = [
        'Molokom', 'Holy Molly', 'Belom', 'Imen', 'Imenka',
        'Semilac', 'Indigo Nails', 'NeoNail', 'Gelish', 'OPI', 'CND Shellac',
        'Kodi Professional', 'Komilfo', 'Oxxi Professional', 'Global Fashion',
        'Siller Professional', 'Lovely', 'Naomi', 'FOX', 'Couture Colour',
        'Moon Full', 'Podomonium', 'Staleks', 'Gehwol', 'Alessandro',
        'LCN', 'IBD', 'Young Nails', 'Presto', 'Akzentz',
        'Bio Sculpture', 'Light Elegance', 'Luxio', 'Apres', 'Ugly Duckling',
        'Orly', 'Essie', 'Zoya', 'LeChat', 'Revel Nail',
        'Kiara Sky', 'DND', 'Modelones', 'Beetles', 'Makartt'
      ];

      var productsByTab = {
        'New Arrivals': [
          { name: 'Luxe Gel Polish - Nude Rose', price: 'EUR 14.99', badge: 'New' },
          { name: 'Professional Base Coat', price: 'EUR 11.99' },
          { name: 'UV/LED Nail Lamp 48W', price: 'EUR 39.99', oldPrice: 'EUR 54.99', badge: 'Sale' },
          { name: 'Nail Art Brush Set (15 pcs)', price: 'EUR 18.99', badge: 'Bestseller' },
          { name: 'Cuticle Oil - Almond', price: 'EUR 7.99' },
          { name: 'Glitter Collection Set', price: 'EUR 22.99', badge: 'New' },
          { name: 'Gel Extension Kit', price: 'EUR 34.99', oldPrice: 'EUR 44.99', badge: 'Sale' },
          { name: 'Matte Top Coat', price: 'EUR 9.99' },
          { name: 'Pro Nail File Set (3 pcs)', price: 'EUR 5.99' },
          { name: 'Hand Cream Professional', price: 'EUR 12.99', badge: 'Bestseller' }
        ],
        'Bestsellers': [
          { name: 'Luxe Gel Polish - Nude Rose', price: 'EUR 14.99', badge: 'Bestseller' },
          { name: 'UV/LED Nail Lamp 48W', price: 'EUR 39.99', badge: 'Bestseller' },
          { name: 'Nail Art Brush Set (15 pcs)', price: 'EUR 18.99', badge: 'Bestseller' },
          { name: 'Gel Extension Kit', price: 'EUR 34.99', oldPrice: 'EUR 44.99', badge: 'Sale' },
          { name: 'Professional Base Coat', price: 'EUR 11.99' },
          { name: 'Glitter Collection Set', price: 'EUR 22.99' },
          { name: 'Hand Cream Professional', price: 'EUR 12.99' },
          { name: 'Matte Top Coat', price: 'EUR 9.99' },
          { name: 'Cuticle Oil - Almond', price: 'EUR 7.99' },
          { name: 'Pro Nail File Set (3 pcs)', price: 'EUR 5.99' }
        ],
        'Hot Items': [
          { name: 'UV/LED Nail Lamp 48W', price: 'EUR 39.99', oldPrice: 'EUR 54.99', badge: 'Sale' },
          { name: 'Luxe Gel Polish - Nude Rose', price: 'EUR 14.99', badge: 'New' },
          { name: 'Glitter Collection Set', price: 'EUR 22.99' },
          { name: 'Gel Extension Kit', price: 'EUR 34.99', oldPrice: 'EUR 44.99', badge: 'Sale' },
          { name: 'Hand Cream Professional', price: 'EUR 12.99', badge: 'Bestseller' },
          { name: 'Professional Base Coat', price: 'EUR 11.99' },
          { name: 'Nail Art Brush Set (15 pcs)', price: 'EUR 18.99' },
          { name: 'Cuticle Oil - Almond', price: 'EUR 7.99' },
          { name: 'Matte Top Coat', price: 'EUR 9.99' },
          { name: 'Pro Nail File Set (3 pcs)', price: 'EUR 5.99' }
        ]
      };

      var shopByProducts = [
        { name: 'Nude Collection 6-Pack', price: 'EUR 49.99', oldPrice: 'EUR 64.99', badge: 'Sale' },
        { name: 'French Manicure Set', price: 'EUR 24.99', badge: 'Bestseller' },
        { name: 'Builder Gel Clear 30ml', price: 'EUR 16.99' },
        { name: 'Polygel Starter Kit', price: 'EUR 42.99', badge: 'New' },
        { name: 'Rubber Base Coat 15ml', price: 'EUR 13.99' }
      ];

      var favorites = [
        { name: 'Starter Kit Premium', price: 'EUR 69.99', oldPrice: 'EUR 89.99', badge: 'Sale' },
        { name: 'Nail Art Decoration Set', price: 'EUR 28.99', badge: 'Bestseller' },
        { name: 'Professional Lamp 96W', price: 'EUR 59.99' },
        { name: 'Cuticle Oil Set 3-Pack', price: 'EUR 19.99', badge: 'New' },
        { name: 'Gel Remover Kit', price: 'EUR 14.99' }
      ];

      var icons = {
        heart: '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21s-7-4.4-9.4-8.5C.8 9.3 2.1 5.5 5.8 4.7c2.1-.5 4.3.3 5.6 2.1 1.3-1.8 3.5-2.6 5.6-2.1 3.7.8 5 4.6 3.2 7.8C19 16.6 12 21 12 21z"></path></svg>',
        bag: '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 8h12l-1 12H7L6 8z"></path><path d="M9 8V6a3 3 0 1 1 6 0v2"></path></svg>'
      };

      function escapeHtml(value) {
        return String(value)
          .replace(/&/g, '&amp;')
          .replace(/</g, '&lt;')
          .replace(/>/g, '&gt;')
          .replace(/"/g, '&quot;')
          .replace(/'/g, '&#39;');
      }

      function cardTemplate(product) {
        var badgeClass = '';
        if (product.badge === 'Sale') badgeClass = 'na-badge-sale';
        if (product.badge === 'Bestseller') badgeClass = 'na-badge-bestseller';
        if (product.badge === 'New') badgeClass = 'na-badge-new';

        return [
          '<article class="na-card">',
            '<div class="na-card-media">',
              product.badge ? '<span class="na-card-badge ' + badgeClass + '">' + escapeHtml(product.badge) + '</span>' : '',
              '<button type="button" class="na-card-heart" aria-label="Add to favorites">' + icons.heart + '</button>',
              '<div class="na-card-quick">',
                '<button type="button" class="na-card-cart">' + icons.bag + 'Add to Cart</button>',
              '</div>',
            '</div>',
            '<h3 class="na-card-name">' + escapeHtml(product.name) + '</h3>',
            '<div class="na-card-prices">',
              '<span class="na-card-price">' + escapeHtml(product.price) + '</span>',
              product.oldPrice ? '<span class="na-card-price-old">' + escapeHtml(product.oldPrice) + '</span>' : '',
            '</div>',
          '</article>'
        ].join('');
      }

      function renderCards(target, items) {
        if (!target) return;
        target.innerHTML = items.map(cardTemplate).join('');
      }

      var brandGrid = root.querySelector('[data-na-brands-grid]');
      var brandToggle = root.querySelector('[data-na-brands-toggle]');
      var showAllBrands = false;
      var initialBrands = 20;

      function renderBrands() {
        if (!brandGrid) return;
        var visible = showAllBrands ? brands : brands.slice(0, initialBrands);
        brandGrid.innerHTML = visible
          .map(function (brand) {
            return '<a class="na-brand-item" href="' + allProductsUrl + '">' + escapeHtml(brand) + '</a>';
          })
          .join('');

        if (!brandToggle) return;
        brandToggle.textContent = showAllBrands ? 'Show Less' : 'Show All ' + brands.length + ' Brands';
      }

      if (brandToggle) {
        brandToggle.addEventListener('click', function () {
          showAllBrands = !showAllBrands;
          renderBrands();
        });
      }
      renderBrands();

      var activeTab = 'New Arrivals';
      var productGrid = root.querySelector('[data-na-product-grid]');
      var tabButtons = root.querySelectorAll('[data-na-tab]');

      function renderActiveTab() {
        renderCards(productGrid, productsByTab[activeTab] || productsByTab['New Arrivals']);
        tabButtons.forEach(function (button) {
          button.classList.toggle('is-active', button.getAttribute('data-na-tab') === activeTab);
        });
      }

      tabButtons.forEach(function (button) {
        button.addEventListener('click', function () {
          var tab = button.getAttribute('data-na-tab');
          if (!tab || tab === activeTab) return;
          activeTab = tab;
          renderActiveTab();
        });
      });

      renderActiveTab();
      renderCards(root.querySelector('[data-na-tools-grid]'), shopByProducts);
      renderCards(root.querySelector('[data-na-favorites-grid]'), favorites);

      var copyButton = root.querySelector('[data-na-copy]');
      var copyLabel = root.querySelector('[data-na-copy-label]');
      var copiedTimeout;

      if (copyButton && copyLabel) {
        copyButton.addEventListener('click', function () {
          if (navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard.writeText('NAIL20').catch(function () {});
          }

          copyLabel.textContent = 'Copied!';
          window.clearTimeout(copiedTimeout);
          copiedTimeout = window.setTimeout(function () {
            copyLabel.textContent = 'Copy Code: NAIL20';
          }, 2000);
        });
      }

      var countdownDays = root.querySelector('[data-na-days]');
      var countdownHours = root.querySelector('[data-na-hours]');
      var countdownMinutes = root.querySelector('[data-na-minutes]');
      var countdownSeconds = root.querySelector('[data-na-seconds]');

      var timeLeft = {
        days: 5,
        hours: 13,
        minutes: 27,
        seconds: 44
      };

      function pad(n) {
        return String(n).padStart(2, '0');
      }

      function renderCountdown() {
        if (!countdownDays || !countdownHours || !countdownMinutes || !countdownSeconds) return;
        countdownDays.textContent = pad(timeLeft.days);
        countdownHours.textContent = pad(timeLeft.hours);
        countdownMinutes.textContent = pad(timeLeft.minutes);
        countdownSeconds.textContent = pad(timeLeft.seconds);
      }

      function tickCountdown() {
        if (
          timeLeft.days <= 0 &&
          timeLeft.hours <= 0 &&
          timeLeft.minutes <= 0 &&
          timeLeft.seconds <= 0
        ) {
          return;
        }

        timeLeft.seconds -= 1;
        if (timeLeft.seconds < 0) {
          timeLeft.seconds = 59;
          timeLeft.minutes -= 1;
        }
        if (timeLeft.minutes < 0) {
          timeLeft.minutes = 59;
          timeLeft.hours -= 1;
        }
        if (timeLeft.hours < 0) {
          timeLeft.hours = 23;
          timeLeft.days -= 1;
        }
        if (timeLeft.days < 0) {
          timeLeft.days = 0;
          timeLeft.hours = 0;
          timeLeft.minutes = 0;
          timeLeft.seconds = 0;
        }

        renderCountdown();
      }

      renderCountdown();
      window.setInterval(tickCountdown, 1000);
    })();
  </script>
</section>

