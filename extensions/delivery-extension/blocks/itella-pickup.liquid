{% assign last_address = customer.last_order.shipping_address | default: customer.default_address %}

<div
  class="pickup-card"
  data-itella-pickup-root="1"
  data-default-country="{{ localization.country.iso_code }}"
  data-label-country="{{ 'pickup.labels.country' | t }}"
  data-label-provider="{{ 'pickup.labels.provider' | t }}"
  data-label-pickup-point="{{ 'pickup.labels.pickup_point' | t }}"
  data-text-loading="{{ 'pickup.text.loading' | t }}"
  data-text-select-pickup="{{ 'pickup.text.select_pickup' | t }}"
  data-text-pickup-not-required="{{ 'pickup.text.pickup_not_required' | t }}"
  data-text-no-providers="{{ 'pickup.text.no_providers' | t }}"
  data-text-no-points="{{ 'pickup.text.no_points' | t }}"
  data-text-selected="{{ 'pickup.text.selected' | t }}"
  data-text-price-label="{{ 'pickup.text.price_label' | t }}"
  data-text-search-placeholder="{{ 'pickup.text.search_placeholder' | t }}"
  data-text-fallback="{{ 'pickup.text.fallback_notice' | t }}"
  data-customer-logged-in="{% if customer %}true{% else %}false{% endif %}"
  data-customer-id="{{ customer.id | default: '' | escape }}"
  data-customer-email="{{ customer.email | escape }}"
  data-customer-name="{{ last_address.name | escape }}"
  data-customer-address1="{{ last_address.address1 | escape }}"
  data-customer-city="{{ last_address.city | escape }}"
  data-customer-zip="{{ last_address.zip | escape }}"
  data-customer-phone="{{ last_address.phone | escape }}"
  data-customer-phone-code=""
>
  <div class="pickup-fallback" id="pickup-fallback" hidden></div>

  <section class="pickup-panel pickup-panel--promo">
    <h3 class="pickup-panel__title">Promo code</h3>
    <div class="pickup-field">
      <div class="pickup-promo-row">
        <input id="pickup-promo" class="pickup-input" type="text" placeholder="Enter promo code" />
        <button id="pickup-promo-apply" class="pickup-promo-apply" type="button">Apply</button>
      </div>
      <div id="pickup-promo-status" class="pickup-promo-status" hidden></div>
      <p class="pickup-meta-note">One code per order. Discount is applied at checkout.</p>
    </div>
  </section>

  <section class="pickup-panel">
    <h3 class="pickup-panel__title">{{ 'pickup.labels.country' | t }}</h3>
    <button class="pickup-select" id="pickup-country-btn" type="button">
      <span class="pickup-flag" id="pickup-country-flag"></span>
      <span id="pickup-country-label">{{ 'pickup.text.loading' | t }}</span>
      <span class="pickup-chevron">▾</span>
    </button>
    <div class="pickup-menu" id="pickup-country-menu" hidden></div>
  </section>

  <section class="pickup-panel">
    <h3 class="pickup-panel__title">{{ 'pickup.labels.provider' | t }}</h3>
    <div id="pickup-providers" class="pickup-providers"></div>

    <div class="pickup-points" id="pickup-points">
      <div class="pickup-points-title">{{ 'pickup.labels.pickup_point' | t }}</div>
      <button class="pickup-select" id="pickup-point-btn" type="button">
        <span id="pickup-point-label">{{ 'pickup.text.select_pickup' | t }}</span>
        <span class="pickup-chevron">▾</span>
      </button>

      <div class="pickup-menu pickup-points-menu" id="pickup-point-menu" hidden>
        <div class="pickup-menu-search">
          <input
            id="pickup-search"
            class="pickup-input"
            type="text"
            placeholder="{{ 'pickup.text.search_placeholder' | t }}"
          />
        </div>
        <div id="pickup-point-list" class="pickup-point-list"></div>
      </div>
    </div>

    <div id="pickup-current" class="pickup-current"></div>
  </section>

  <section class="pickup-panel">
    <h3 class="pickup-panel__title">Recipient details</h3>

    <div class="pickup-field">
      <label for="pickup-name">Full name</label>
      <input id="pickup-name" class="pickup-input" type="text" placeholder="Name" />
    </div>

    <div class="pickup-field">
      <label for="pickup-address1">Address</label>
      <input id="pickup-address1" class="pickup-input" type="text" placeholder="Street and house" />
    </div>

    <div class="pickup-field-row">
      <div class="pickup-field">
        <label for="pickup-city">City</label>
        <input id="pickup-city" class="pickup-input" type="text" placeholder="City" />
      </div>
      <div class="pickup-field">
        <label for="pickup-zip">Postal code</label>
        <input id="pickup-zip" class="pickup-input" type="text" placeholder="Postal code" />
      </div>
    </div>

    <div class="pickup-field-row pickup-field-row--phone">
      <div class="pickup-field pickup-field--phone-code">
        <label for="pickup-phone-code">Code</label>
        <select id="pickup-phone-code" class="pickup-input">
          <option value="+372">+372 (EE)</option>
          <option value="+371">+371 (LV)</option>
          <option value="+370">+370 (LT)</option>
          <option value="+358">+358 (FI)</option>
        </select>
      </div>

      <div class="pickup-field">
        <label for="pickup-phone">Phone</label>
        <input id="pickup-phone" class="pickup-input" type="text" placeholder="Phone" />
      </div>
    </div>

    <div class="pickup-field">
      <label for="pickup-email">Email</label>
      <input id="pickup-email" class="pickup-input" type="email" placeholder="Email" />
      {% if customer %}
        <p class="pickup-meta-note">We prefilled your account email. You can still edit it.</p>
      {% endif %}
    </div>
  </section>

  <section class="pickup-panel pickup-wolt" id="pickup-wolt" hidden>
    <h3 class="pickup-panel__title">Wolt delivery time</h3>
    <div class="pickup-wolt-notice" id="pickup-wolt-notice" hidden></div>
    <div class="pickup-wolt-fields">
      <div class="pickup-field">
        <label for="pickup-wolt-date">Delivery date</label>
        <input id="pickup-wolt-date" class="pickup-input" type="date" />
      </div>
      <div class="pickup-field">
        <label for="pickup-wolt-time">Delivery time</label>
        <select id="pickup-wolt-time" class="pickup-input"></select>
      </div>
    </div>
  </section>

  <section class="pickup-panel pickup-panel--checkout">
    <button class="pickup-checkout" data-itella-checkout-btn type="button">
      Proceed to checkout
    </button>
    <p class="pickup-meta-note">You will be redirected to invoice checkout.</p>
  </section>
</div>

<style>
  .pickup-card {
    width: 100%;
    display: grid;
    gap: 12px;
  }

  .pickup-fallback {
    border: 1px solid rgba(180, 83, 9, 0.25);
    background: rgba(251, 191, 36, 0.16);
    color: #92400e;
    border-radius: 12px;
    padding: 10px 12px;
    font-size: 13px;
    font-weight: 600;
  }

  .pickup-panel {
    background: #ffffff;
    border: 1px solid #d9dee3;
    border-radius: 16px;
    padding: 14px;
    display: grid;
    gap: 10px;
  }

  .pickup-panel__title {
    margin: 0;
    font-size: 18px;
    line-height: 1.2;
    font-weight: 700;
    letter-spacing: -0.01em;
    color: #12181f;
  }

  .pickup-panel--promo .pickup-panel__title,
  .pickup-panel--checkout .pickup-panel__title {
    font-size: 18px;
  }

  .pickup-field {
    display: grid;
    gap: 6px;
    font-size: 13px;
    color: #374151;
  }

  .pickup-field label {
    font-weight: 600;
    color: #374151;
  }

  .pickup-field-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
  }

  .pickup-field--phone-code {
    max-width: 140px;
  }

  .pickup-input {
    width: 100%;
    min-height: 44px;
    padding: 10px 12px;
    border-radius: 10px;
    border: 1px solid #cfd6dc;
    background: #fff;
    color: #111827;
    font-size: 14px;
    line-height: 1.35;
  }

  .pickup-input:focus {
    border-color: #4b8f00;
    outline: none;
    box-shadow: 0 0 0 3px rgba(75, 143, 0, 0.12);
  }

  .pickup-meta-note {
    margin: 0;
    font-size: 12px;
    line-height: 1.35;
    color: #6b7280;
  }

  .pickup-promo-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 10px;
    align-items: center;
  }

  .pickup-promo-apply {
    min-height: 44px;
    padding: 10px 18px;
    border: 1px solid #4b8f00;
    border-radius: 10px;
    background: #fff;
    color: #2f6e00;
    font-size: 16px;
    font-weight: 700;
    cursor: pointer;
    white-space: nowrap;
  }

  .pickup-promo-status {
    font-size: 12px;
    margin-top: 2px;
  }

  .pickup-promo-status[data-tone="ok"] {
    color: #166534;
  }

  .pickup-promo-status[data-tone="error"] {
    color: #b91c1c;
  }

  .pickup-select {
    width: 100%;
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: 44px;
    padding: 10px 12px;
    border-radius: 10px;
    border: 1px solid #cfd6dc;
    background: #fff;
    color: #111827;
    justify-content: flex-start !important;
    text-align: left !important;
    cursor: pointer;
  }

  #pickup-country-label,
  #pickup-point-label {
    flex: 1;
    text-align: left !important;
  }

  .pickup-flag {
    width: 22px;
    height: 14px;
    border-radius: 3px;
    background: #e5e7eb;
    display: inline-block;
    background-size: cover;
    background-position: center;
  }

  .pickup-chevron {
    opacity: 0.65;
    margin-left: auto;
  }

  .pickup-menu {
    margin-top: 8px;
    background: #fff;
    border: 1px solid #d9dee3;
    border-radius: 10px;
    overflow: hidden;
    box-shadow: 0 8px 20px rgba(15, 23, 42, 0.1);
  }

  .pickup-menu button,
  .pickup-point-option {
    width: 100%;
    padding: 10px 12px;
    display: flex;
    gap: 10px;
    align-items: center;
    background: #fff;
    border: 0;
    text-align: left !important;
    justify-content: flex-start !important;
    cursor: pointer;
  }

  .pickup-menu button:hover,
  .pickup-point-option:hover {
    background: #f4f7f8;
  }

  .pickup-menu-search {
    padding: 10px 12px;
    border-bottom: 1px solid #e5e7eb;
  }

  .pickup-providers {
    display: grid;
    gap: 10px;
  }

  .pickup-provider {
    display: grid;
    grid-template-columns: auto auto minmax(0, 1fr) auto;
    align-items: start;
    gap: 10px;
    padding: 10px 12px;
    border-radius: 10px;
    border: 1px solid #cfd6dc;
    background: #fff;
    cursor: pointer;
  }

  .pickup-provider input {
    --active: #111827;
    --active-inner: #ffffff;
    --border: #9ca3af;
    --border-hover: #4b8f00;
    accent-color: #4b8f00;
    margin: 0;
    align-self: start;
    margin-top: 2px;
  }

  .pickup-provider input[type='radio']::after {
    inset-inline-start: 50%;
    inset-block-start: 50%;
    transform: translate(-50%, -50%);
  }

  .pickup-provider:has(input:checked) {
    border-color: #4b8f00;
    background: #f6fbef;
    box-shadow: 0 0 0 2px rgba(75, 143, 0, 0.1);
  }

  .pickup-provider img {
    width: 84px;
    height: auto;
  }

  .pickup-provider.is-disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .pickup-provider-note {
    font-size: 12px;
    color: #6b7280;
  }

  .pickup-points {
    display: grid;
    gap: 8px;
    position: relative;
  }

  .pickup-points-title {
    font-weight: 600;
    font-size: 14px;
    color: #1f2937;
  }

  .pickup-points-menu {
    max-height: 280px;
    overflow: auto;
    position: absolute;
    left: 0;
    right: 0;
    top: 100%;
    z-index: 20;
  }

  .pickup-point-list {
    display: grid;
  }

  .pickup-country-code {
    font-size: 12px;
    font-weight: 700;
    color: #6b7280;
  }

  .pickup-country-name {
    color: #111827;
  }

  .pickup-current {
    margin-top: 4px;
    font-size: 13px;
    color: #475569;
  }

  .pickup-checkout {
    width: 100%;
    min-height: 50px;
    border: 1px solid #4b8f00;
    border-radius: 10px;
    background: #4b8f00;
    color: #fff;
    font-size: 18px;
    font-weight: 700;
    cursor: pointer;
  }

  .pickup-wolt {
    display: grid;
    gap: 10px;
  }

  .pickup-wolt-fields {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 10px;
    align-items: start;
  }

  .pickup-wolt-notice {
    font-size: 12px;
    color: #92400e;
    background: rgba(251, 191, 36, 0.18);
    border-radius: 10px;
    padding: 8px 10px;
  }

  [hidden] {
    display: none !important;
  }

  @media (max-width: 749px) {
    .pickup-panel {
      padding: 12px;
      border-radius: 14px;
    }

    .pickup-panel__title {
      font-size: 17px;
    }

    .pickup-promo-apply {
      min-width: 96px;
      padding-inline: 12px;
      font-size: 15px;
    }

    .pickup-field-row {
      grid-template-columns: 1fr;
    }

    .pickup-wolt-fields {
      grid-template-columns: 1fr;
    }

    .pickup-field--phone-code {
      max-width: none;
    }

    .pickup-provider {
      grid-template-columns: auto minmax(0, 1fr);
      align-items: start;
    }

    .pickup-provider img,
    .pickup-provider-note {
      grid-column: 2;
    }
  }
</style>

<script>
  window.__MK_CUSTOMER_LOGGED_IN = {% if customer %}true{% else %}false{% endif %};
  window.__MK_CUSTOMER_ID = "{{ customer.id | default: '' | escape }}";
</script>

<script src="{{ 'itella-pickup.js' | asset_url }}" defer></script>
<script src="{{ 'cart-campaign-ui.js' | asset_url }}" defer></script>
<script src="{{ 'cart.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Pickup selector",
  "target": "section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Config is loaded via App Proxy at /apps/checkout/pickup-config."
    }
  ]
}
{% endschema %}
