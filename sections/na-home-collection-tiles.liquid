{% liquid
  assign all_products_url = routes.all_products_collection_url
  assign tile_blocks = section.blocks | where: 'type', 'tile'
  assign fallback_labels = 'Gel Base|Salon Equipment|Acryl & Extensions|Nail Art Supplies|Body Care|Accessories' | split: '|'
%}
<section class="na-home-section na-home-tiles">
  <div class="na-home-wrap">
    <h2 class="na-home-tiles-title">{{ section.settings.heading_prefix }} <span class="accent">{{ section.settings.heading_highlight }}</span><br>{{ section.settings.heading_suffix }}</h2>
    <div class="na-home-tiles-grid">
      {% if tile_blocks.size > 0 %}
        {% for block in tile_blocks %}
          {% assign tile_collection = block.settings.collection %}
          {% assign tile_label = block.settings.label %}
          {% assign tile_link = block.settings.link %}
          {% assign tile_image = block.settings.image %}
          {% if tile_collection != blank %}
            {% if tile_label == blank %}{% assign tile_label = tile_collection.title %}{% endif %}
            {% if tile_link == blank %}{% assign tile_link = tile_collection.url %}{% endif %}
            {% if tile_image == blank %}{% assign tile_image = tile_collection.featured_image | default: tile_collection.products.first.featured_image %}{% endif %}
          {% endif %}
          <a href="{{ tile_link | default: all_products_url }}" class="na-home-image-card{% if tile_image != blank %} has-image{% endif %}" {% if tile_image != blank %}style="background-image: url('{{ tile_image | image_url: width: 1000 }}');"{% endif %} {{ block.shopify_attributes }}>
            <div class="na-home-image-card-content">
              <p class="na-home-image-card-title">{{ tile_label | default: 'Collection' }}</p>
              <span class="na-home-image-card-arrow" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M7 17L17 7"></path><path d="M9 7h8v8"></path></svg></span>
            </div>
          </a>
        {% endfor %}
      {% else %}
        {% for item in fallback_labels %}
          <a href="{{ all_products_url }}" class="na-home-image-card">
            <div class="na-home-image-card-content">
              <p class="na-home-image-card-title">{{ item }}</p>
              <span class="na-home-image-card-arrow" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M7 17L17 7"></path><path d="M9 7h8v8"></path></svg></span>
            </div>
          </a>
        {% endfor %}
      {% endif %}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "NA Collection Tiles",
  "settings": [
    { "type": "text", "id": "heading_prefix", "label": "Heading prefix", "default": "Explore our collection of" },
    { "type": "text", "id": "heading_highlight", "label": "Heading highlight", "default": "Professional Tools" },
    { "type": "text", "id": "heading_suffix", "label": "Heading suffix", "default": "from top brands in the industry" }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Collection tile",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "text", "id": "label", "label": "Custom label" },
        { "type": "url", "id": "link", "label": "Custom link" },
        { "type": "image_picker", "id": "image", "label": "Custom image" }
      ]
    }
  ],
  "presets": [
    { "name": "NA Collection Tiles" }
  ]
}
{% endschema %}
