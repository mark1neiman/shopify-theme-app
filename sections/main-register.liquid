{{ 'customer.css' | asset_url | stylesheet_tag }}

<div
  class="customer register--split login--split section section--padding"
  style="--section-padding-top: {{ section.settings.padding_top }}px;--section-padding-bottom: {{ section.settings.padding_bottom }}px;"
>
  <div class="section__wrapper">
    <div class="login-shell">
      <div class="login-card blocks-radius">
        <div class="login-card__form-column">
          <div class="login-card__topbar">
            <a href="{{ routes.root_url }}" class="btn--link">{{ section.settings.back_link_label }}</a>
          </div>

          <h1 class="h2 login-card__title">
            {%- if section.settings.heading != blank -%}
              {{- section.settings.heading -}}
            {%- else -%}
              {{- 'customer.register.title' | t -}}
            {%- endif -%}
          </h1>

          <p class="login-card__subtitle text-subtext">
            {%- if section.settings.subheading != blank -%}
              {{- section.settings.subheading -}}
            {%- else -%}
              Create your account to track orders and manage addresses faster.
            {%- endif -%}
          </p>

          <div class="login-panel">
            {%- form 'create_customer', class: 'flex flex-col login-form' -%}
              {%- if form.errors -%}
                <div class="form-error alert alert--error blocks-radius">
                  <h2 class="form-message form-message--error h6 m-0" tabindex="-1" autofocus>
                    {% render 'icon-error', size: 'small' %}
                    {{ 'templates.contact.form.error_heading' | t }}
                  </h2>
                  <ul>
                    {%- for field in form.errors -%}
                      <li>
                        {%- if field == 'form' -%}
                          {{ form.errors.messages[field] }}
                        {%- else -%}
                          <a href="#RegisterForm-{{ field }}">
                            {{ form.errors.translated_fields[field] | capitalize }}
                            {{ form.errors.messages[field] }}
                          </a>
                        {%- endif -%}
                      </li>
                    {%- endfor -%}
                  </ul>
                </div>
              {%- endif -%}

              <div class="form-field">
                <label for="RegisterForm-FirstName" class="form-label">
                  {{ 'customer.register.first_name' | t }}
                </label>
                <input
                  type="text"
                  name="customer[first_name]"
                  id="RegisterForm-FirstName"
                  {% if form.first_name %}
                    value="{{ form.first_name }}"
                  {% endif %}
                  autocomplete="given-name"
                  placeholder="{{ 'customer.register.first_name' | t }}"
                  class="form-control"
                >
              </div>

              <div class="form-field">
                <label for="RegisterForm-LastName" class="form-label">
                  {{ 'customer.register.last_name' | t }}
                </label>
                <input
                  type="text"
                  name="customer[last_name]"
                  id="RegisterForm-LastName"
                  {% if form.last_name %}
                    value="{{ form.last_name }}"
                  {% endif %}
                  autocomplete="family-name"
                  placeholder="{{ 'customer.register.last_name' | t }}"
                  class="form-control"
                >
              </div>

              <div class="form-field">
                <label for="RegisterForm-email" class="form-label">
                  {{ 'customer.register.email' | t }}
                </label>
                <input
                  required
                  type="email"
                  name="customer[email]"
                  id="RegisterForm-email"
                  {% if form.email %}
                    value="{{ form.email }}"
                  {% endif %}
                  spellcheck="false"
                  autocapitalize="off"
                  autocomplete="email"
                  aria-required="true"
                  {% if form.errors contains 'email' %}
                    aria-invalid="true"
                    aria-describedby="RegisterForm-email-error"
                  {% endif %}
                  placeholder="{{ 'customer.register.email' | t }}"
                  class="form-control"
                >
                {%- if form.errors contains 'email' -%}
                  <span id="RegisterForm-email-error" class="form-message form-message--small form-message--error">
                    {% render 'icon-error', size: 'small' %}
                    {{ form.errors.translated_fields.email | capitalize }}
                    {{ form.errors.messages.email }}.
                  </span>
                {%- endif -%}
              </div>

              <div class="form-field">
                <label for="RegisterForm-password" class="form-label">
                  {{ 'customer.register.password' | t }}
                </label>
                <input
                  required
                  type="password"
                  name="customer[password]"
                  id="RegisterForm-password"
                  aria-required="true"
                  {% if form.errors contains 'password' %}
                    aria-invalid="true"
                    aria-describedby="RegisterForm-password-error"
                  {% endif %}
                  placeholder="{{ 'customer.register.password' | t }}"
                  class="form-control"
                >
                {%- if form.errors contains 'password' -%}
                  <span id="RegisterForm-password-error" class="form-message form-message--small form-message--error">
                    {% render 'icon-error', size: 'small' %}
                    {{ form.errors.translated_fields.password | capitalize }}
                    {{ form.errors.messages.password }}.
                  </span>
                {%- endif -%}
              </div>

              <button class="btn btn--primary w-full">
                <span class="btn__text">{{ 'customer.register.submit' | t }}</span>
              </button>

              <a href="{{ routes.account_login_url }}" class="btn btn--underline self-center">
                {{ 'customer.login_page.sign_in' | t }}
              </a>
            {%- endform -%}
          </div>
        </div>

        <aside class="login-card__benefits" aria-label="{{ section.settings.benefits_heading }}">
          <h2 class="h4 m-0">{{ section.settings.benefits_heading }}</h2>

          <ul class="login-benefits list-unstyled" role="list">
            {%- for index in (1..6) -%}
              {%- assign setting_key = 'benefit_' | append: index -%}
              {%- assign benefit_text = section.settings[setting_key] -%}
              {%- if benefit_text != blank -%}
                <li>
                  <span class="login-benefits__icon" aria-hidden="true">✓</span>
                  <span>{{ benefit_text }}</span>
                </li>
              {%- endif -%}
            {%- endfor -%}
          </ul>

          {%- if section.settings.benefits_footer != blank -%}
            <p class="login-card__benefits-footer text-subtext">{{ section.settings.benefits_footer }}</p>
          {%- endif -%}
        </aside>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.main-register.name",
  "settings": [
    {
      "type": "text",
      "id": "back_link_label",
      "label": "Back link label",
      "default": "Back to store"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Create an account"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Create your account to checkout faster and keep your orders in one place."
    },
    {
      "type": "header",
      "content": "Benefits column"
    },
    {
      "type": "text",
      "id": "benefits_heading",
      "label": "Benefits heading",
      "default": "Why shop with us?"
    },
    {
      "type": "text",
      "id": "benefit_1",
      "label": "Benefit 1",
      "default": "Fast order processing and delivery updates"
    },
    {
      "type": "text",
      "id": "benefit_2",
      "label": "Benefit 2",
      "default": "Secure checkout with trusted payment methods"
    },
    {
      "type": "text",
      "id": "benefit_3",
      "label": "Benefit 3",
      "default": "Verified customer reviews"
    },
    {
      "type": "text",
      "id": "benefit_4",
      "label": "Benefit 4",
      "default": "Direct support whenever you need help"
    },
    {
      "type": "text",
      "id": "benefit_5",
      "label": "Benefit 5",
      "default": "Simple returns and clear order history"
    },
    {
      "type": "text",
      "id": "benefit_6",
      "label": "Benefit 6",
      "default": "Personalized offers for signed-in customers"
    },
    {
      "type": "textarea",
      "id": "benefits_footer",
      "label": "Benefits footer",
      "default": "Create an account once and manage everything from your dashboard."
    },
    {
      "type": "header",
      "content": "t:general.padding.section_heading.content"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "t:general.padding.top.label",
      "default": 100
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "t:general.padding.bottom.label",
      "default": 100
    }
  ]
}
{% endschema %}
